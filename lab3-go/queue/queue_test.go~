package queue

import "testing"

func TestQueue(t *testing.T) {
	q := New()
	if !q.IsEmpty() {
		t.Error("Expected empty")
	}

	q.Push("10")
	q.Push("20")
	q.Push("30")

	if q.Size() != 3 {
		t.Error("Expected size 3")
	}

	if v, ok := q.Front(); !ok || v != "10" {
		t.Error("Front failed")
	}

	if v, ok := q.Pop(); !ok || v != "10" {
		t.Error("Pop failed")
	}
	if q.Size() != 2 {
		t.Error("Expected size 2")
	}

	q.Pop()
	q.Pop()
	if !q.IsEmpty() {
		t.Error("Expected empty after pops")
	}
	if _, ok := q.Pop(); ok {
		t.Error("Pop on empty should return false")
	}
}